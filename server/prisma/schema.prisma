generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  dishes    Dish[]
}

model Dish {
  id          Int      @id @default(autoincrement())
  name        String
  difficulty  Int      @default(1)       // 难度 1-5 星
  duration    Int      @default(0)       // 制作时长（分钟）
  description String   @default("")
  image       String   @default("")
  status      String   @default("ENABLED") // ENABLED | DISABLED
  sort        Int      @default(0)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
}

model PhoneWhitelist {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String   @default("")        // 备注名称
  createdAt DateTime @default(now())
}

model Order {
  id         Int      @id @default(autoincrement())
  tableNo    String
  items      String   // JSON: [{dishId, name, price, quantity}]
  totalPrice Float
  status     String   @default("PENDING") // PENDING | PREPARING | COMPLETED | CANCELLED
  note       String   @default("")
  createdAt  DateTime @default(now())
}
