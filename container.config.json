{
  // 微信云托管部署配置（模板部署用，控制台修改为准）
  "containerPort": 80,
  "dockerfilePath": "Dockerfile",
  "buildDir": "",
  "minNum": 0,
  "maxNum": 5,
  "cpu": 1,
  "mem": 2,
  "policyType": "cpu",
  "policyThreshold": 80,
  "initialDelaySeconds": 5,
  "customLogs": "stdout",
  "dataBaseName": "order_app",
  "executeSQLs": [
    "CREATE DATABASE IF NOT EXISTS order_app DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;",
    "USE order_app;"
  ]
}
